# Copy this file to .env and fill in the values. Never commit .env.
FLASK_APP=start
FLASK_ENV=development            # 'production' on the live site
SECRET_KEY=                      # python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URL=postgres://localhost:5432/rentista_dev
DB_POOL=5
DB_TIMEOUT=300

# Braintree payments
BRAINTREE_ENVIRONMENT=sandbox    # 'production' to take real payments
Merchant_ID=
Public_Key=
Private_Key=

# Mailgun (order confirmation emails)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=                  # e.g. mg.rentista.nl

# Amazon S3 (product photos)
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Social login
Google_Client_ID=
Google_Client_secret=
Facebook_App_ID=
Facebook_App_Secret=
